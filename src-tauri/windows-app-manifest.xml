<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  League of Legends (WeGame / TenProtect) runs elevated.
  A normal-integrity process cannot raise its window above an elevated one,
  so the helper requests the same level to make the F1 overlay work.
  Keep this file ASCII-only: the manifest resource is embedded with the
  system code page and non-ASCII characters corrupt the XML.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
