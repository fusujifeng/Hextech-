{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARAMHelper",
  "version": "0.1.0",
  "identifier": "com.chenhang.aramhelper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "海克斯大乱斗出装助手",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4QTNFNjc0MUVFQTFEMjYKUldRbUhlb2VkT2FqeUNCWWg4OVZmTjdOU2VOODdpRDVSUjJrMDRaSFlzRS9rRDY3ZklOV3VvRTQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
