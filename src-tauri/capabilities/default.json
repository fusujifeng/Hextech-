{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口 + 悬浮球能力：置顶、拖拽、自动更新、更新后重启",
  "windows": ["main", "ball"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-always-on-top",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
