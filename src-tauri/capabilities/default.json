{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能力：窗口置顶 + 自动更新 + 更新后重启",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-always-on-top",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
